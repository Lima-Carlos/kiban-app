APP_NAME="Kiban"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Single address of the app: each company at APP_URL/<company>/... (and the sign-in return, /auth/callback).
APP_URL=http://localhost:8090

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=kiban_app
DB_USERNAME=kiban
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Empty: each company (subdomain) keeps its own session.
SESSION_DOMAIN=null
SESSION_COOKIE=kiban_app_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=kiban_app_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@kibancore.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# --- Kiban Core (single sign-on and licenses) ---
# Address the browser uses to reach the Core.
KIBAN_CORE_URL=http://localhost:8080
# Address this server uses to reach the Core (inside Docker, "localhost" is the container itself).
KIBAN_CORE_INTERNAL_URL=http://host.docker.internal:8080
# Core → Configurações → Sistemas conectados. The secret NEVER goes to Git.
KIBAN_CORE_CLIENT_ID=
KIBAN_CORE_CLIENT_SECRET=
# Companies are reached at <subdomain>.<this domain> (production: kibancore.com.br).
KIBAN_TIMEZONE=America/Sao_Paulo

# Kiban Ponto: Kiban's CNPJ/CPF and the INPI registration of the program (AFD file, Brazil)
KIBAN_PONTO_DEVELOPER_DOCUMENT=
KIBAN_PONTO_INPI_REGISTRATION=

# Alerts on the phone (web push). Make once with: php artisan kiban:push-keys (never commit real keys)
KIBAN_PUSH_PUBLIC_KEY=
KIBAN_PUSH_PRIVATE_KEY=
